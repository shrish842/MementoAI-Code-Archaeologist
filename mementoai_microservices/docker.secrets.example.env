# Copy this file to `docker.secrets.env` for local Docker runs.
# Keep `docker.secrets.env` out of version control.

# Shared vector store settings.
PINECONE_API_KEY=replace
PINECONE_INDEX_NAME=mementoai

# Summary model key.
GOOGLE_API_KEY=replace

# Use `hash` for the most reliable first local run.
# Change this to another value or remove it if you want the services to try
# loading the transformer model inside containers.
MEMENTO_EMBEDDINGS_MODE=hash

# Optional model overrides.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
GEMINI_MODEL_NAME=gemini-1.5-flash-latest